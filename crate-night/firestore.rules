rules_version = '2';

// CRATE NIGHT — production Firestore rules.
// Admin = the primary owner account (cratenight@gmail.com) or a trusted
// custom claim set from a privileged backend. Never widen these rules.
service cloud.firestore {
  function isSignedIn() {
    return request.auth != null;
  }

  function isAdmin() {
    return isSignedIn()
      && (request.auth.token.get('admin', false) == true
          || request.auth.token.get('email', '') == 'cratenight@gmail.com');
  }

  match /databases/{database}/documents {
    // Guest list & table applications.
    match /applications/{applicationId} {
      // The door sees everything; guests only see their own.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);

      // Guests create their own pending application; the uid is minted from
      // the session (request.auth.uid), never taken from client fields.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['guest-list', 'table']
        && request.resource.data.partySize is int
        && request.resource.data.partySize >= 1
        && request.resource.data.partySize <= 20;

      // Guests may edit their own still-pending application but can never
      // change its status or reassign it; only admins can review.
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.status == resource.data.status);

      allow delete: if isAdmin();
    }

    // Everything else is denied — least privilege by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
